# Copy this file to .env.server on the server. Do not commit .env.server.
# Use unique values; the examples below are intentionally invalid placeholders.
POSTGRES_DB=omniSentinel_db
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password
RABBITMQ_USER=incident_user
RABBITMQ_PASSWORD=replace-with-a-unique-rabbitmq-password

# Keep these values during the final cutover. Use free temporary ports only
# while building or inspecting the stack beside the existing deployments.
API_HOST_PORT=3010
OMNI_BIND_HOST=10.101.2.11
OMNI_HOST_PORT=3000

# Browser-facing map domain. Switch both values together after enabling TLS.
MAP_PUBLIC_URL=http://seiya.futurity.com.ec
MAP_ACCESS_COOKIE_SECURE=false
